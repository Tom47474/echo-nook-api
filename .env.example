APP_NAME=EchoNook API
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Local PostgreSQL. Replace change-me only in the Git-ignored .env file.
DATABASE_URL=postgresql+asyncpg://echo_nook:change-me@127.0.0.1:5432/echo_nook_dev
TEST_DATABASE_URL=postgresql+asyncpg://echo_nook:change-me@127.0.0.1:5432/echo_nook_test
DATABASE_ECHO=false

# Use demo for local UI work without consuming an external model quota.
LLM_PROVIDER=demo
LLM_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=low
# Verify these limits against the selected model before deploying.
LLM_CONTEXT_WINDOW_TOKENS=32768
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TOKEN_SAFETY_MARGIN=1024

# Provider timeout boundaries in seconds. They still apply when limits are disabled.
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=120
LLM_REPLY_TIMEOUT_SECONDS=180
LLM_SUMMARY_TIMEOUT_SECONDS=60

# Master switch: false disables daily, per-minute, concurrency and login-failure limits.
CONVERSATION_LIMIT_ENABLED=false
# Guest and account quotas are configured independently.
CONVERSATION_GUEST_DAILY_LIMIT=20
CONVERSATION_ACCOUNT_DAILY_LIMIT=100
CONVERSATION_GUEST_MINUTE_LIMIT=3
CONVERSATION_ACCOUNT_MINUTE_LIMIT=10
CONVERSATION_GLOBAL_CONCURRENCY_LIMIT=8
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
